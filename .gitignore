htmlcov/

# --- Datos: se regeneran con `python -m src.pipeline`
data/raw/*
!data/raw/.gitkeep
data/clean/*
!data/clean/.gitkeep
data/serving/*
!data/serving/.gitkeep
cards/*
!cards/.gitkeep
informe/*
!informe/.gitkeep

# --- Spark: logs y ficheros que crea en local
